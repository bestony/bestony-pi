{
  "name": "bestony-pi-preset",
  "version": "0.0.36",
  "description": "Bestony's personal Pi coding agent preset — skills, extensions, prompts, and themes.",
  "license": "MIT",
  "author": "bestony",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "preset",
    "skills",
    "extensions",
    "prompts",
    "themes"
  ],
  "files": [
    "extensions",
    "skills",
    "prompts",
    "themes",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bestony/bestony-pi.git"
  },
  "bugs": {
    "url": "https://github.com/bestony/bestony-pi/issues"
  },
  "homepage": "https://github.com/bestony/bestony-pi#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@dietrichgebert/ponytail": "^4.9.0",
    "@lanlance/pi-recap": "^0.3.0",
    "@narumitw/pi-goal": "^0.53.1",
    "@quintinshaw/pi-dynamic-workflows": "^3.7.0",
    "@tintinweb/pi-tasks": "^0.9.0",
    "@tintinweb/pi-subagents": "^0.18.1",
    "pi-cache-optimizer": "^2.8.6",
    "pi-init": "^1.0.0",
    "pi-mcp-adapter": "^2.27.0",
    "pi-session-name": "^0.1.2",
    "pi-web-access": "^0.24.2",
    "pi-xai-oauth": "^1.5.2"
  },
  "bundledDependencies": [
    "@dietrichgebert/ponytail",
    "@lanlance/pi-recap",
    "@narumitw/pi-goal",
    "@quintinshaw/pi-dynamic-workflows",
    "@tintinweb/pi-tasks",
    "@tintinweb/pi-subagents",
    "pi-cache-optimizer",
    "pi-init",
    "pi-mcp-adapter",
    "pi-session-name",
    "pi-web-access",
    "pi-xai-oauth"
  ],
  "pi": {
    "extensions": [
      "./extensions",
      "node_modules/@dietrichgebert/ponytail/pi-extension/index.js",
      "node_modules/@lanlance/pi-recap/extensions/recap.ts",
      "node_modules/@narumitw/pi-goal/src/index.ts",
      "node_modules/pi-web-access/index.ts",
      "node_modules/pi-xai-oauth/extensions",
      "node_modules/pi-mcp-adapter/index.ts",
      "node_modules/pi-cache-optimizer/index.ts",
      "node_modules/pi-session-name/src/index.ts",
      "node_modules/@tintinweb/pi-tasks/src/index.ts",
      "node_modules/@tintinweb/pi-subagents/src/index.ts",
      "node_modules/@quintinshaw/pi-dynamic-workflows/extensions/workflow.ts"
    ],
    "skills": [
      "./skills",
      "node_modules/@dietrichgebert/ponytail/skills",
      "node_modules/pi-web-access/skills",
      "node_modules/pi-init/skills/init/SKILL.md",
      "node_modules/@quintinshaw/pi-dynamic-workflows/skills/workflow-authoring",
      "node_modules/@quintinshaw/pi-dynamic-workflows/skills/workflow-patterns"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
