{
  "name": "bestony-pi-preset",
  "version": "0.0.11",
  "description": "Bestony's personal Pi coding agent preset — skills, extensions, prompts, and themes.",
  "license": "MIT",
  "author": "bestony",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "preset",
    "skills",
    "extensions",
    "prompts",
    "themes"
  ],
  "files": [
    "extensions",
    "skills",
    "prompts",
    "themes",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bestony/bestony-pi.git"
  },
  "bugs": {
    "url": "https://github.com/bestony/bestony-pi/issues"
  },
  "homepage": "https://github.com/bestony/bestony-pi#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@quintinshaw/pi-dynamic-workflows": "^3.4.1",
    "@tintinweb/pi-tasks": "^0.7.2",
    "@tintinweb/pi-subagents": "^0.14.3",
    "pi-cache-optimizer": "^2.6.25",
    "pi-init": "^1.0.0",
    "pi-mcp-adapter": "^2.15.0",
    "pi-session-name": "^0.1.2",
    "pi-web-access": "^0.16.0",
    "pi-xai": "^0.17.1"
  },
  "bundledDependencies": [
    "@quintinshaw/pi-dynamic-workflows",
    "@tintinweb/pi-tasks",
    "@tintinweb/pi-subagents",
    "pi-cache-optimizer",
    "pi-init",
    "pi-mcp-adapter",
    "pi-session-name",
    "pi-web-access",
    "pi-xai"
  ],
  "pi": {
    "extensions": [
      "./extensions",
      "node_modules/pi-web-access/index.ts",
      "node_modules/pi-xai/index.ts",
      "node_modules/pi-mcp-adapter/index.ts",
      "node_modules/pi-cache-optimizer/index.ts",
      "node_modules/pi-session-name/src/index.ts",
      "node_modules/@tintinweb/pi-tasks/src/index.ts",
      "node_modules/@tintinweb/pi-subagents/src/index.ts",
      "node_modules/@quintinshaw/pi-dynamic-workflows/extensions/workflow.ts"
    ],
    "skills": [
      "./skills",
      "node_modules/pi-web-access/skills",
      "node_modules/pi-init/skills/init/SKILL.md",
      "node_modules/@quintinshaw/pi-dynamic-workflows/skills/workflow-authoring",
      "node_modules/@quintinshaw/pi-dynamic-workflows/skills/workflow-patterns"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
