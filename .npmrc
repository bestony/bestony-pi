# Pi packages bundled by this preset routinely declare peer ranges on Pi core packages
# (see README "依赖约定") that the Pi runtime — not this repo — provides at runtime.
# npm's strict peer resolution refuses to install some of them, e.g.
# @mohndoe/pi-atlas@0.2.1 pins @earendil-works/pi-tui ">=0.74.0 <0.77.0" while this
# preset tracks the current Pi release line. `force` tolerates those conflicts while
# still installing the peer tree itself (unlike legacy-peer-deps, which drops it).
force=true
